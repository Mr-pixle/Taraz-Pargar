# Taraz server — copy to .env and fill in. Never commit .env or the service-account key.
POSTGRES_PASSWORD=change-me-strong-password
# first run on an empty database only: the CEO account
TARAZ_ADMIN_USERNAME=ceo
TARAZ_ADMIN_PASSWORD=change-me-at-least-8-chars
TARAZ_ADMIN_NAME=مدیرعامل
# behind HTTPS set 1
TARAZ_COOKIE_SECURE=0
TARAZ_SYNC_SCHEDULE=on
TARAZ_SYNC_EVERY_HOURS=2
TARAZ_SYNC_HOURS=8-19
TARAZ_WRITEBACK_DELAY_SEC=120
